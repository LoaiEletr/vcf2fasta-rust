# ============================================================================
# Rust
# ============================================================================

# Cargo build artifacts
/target/

# Cargo.lock: keep it committed for a binary crate. Remove the `#` below
# only if you decide to switch to a library-style policy.
# Cargo.lock

# Backups and temp files created by `cargo publish`, `cargo test`, etc.
**/*.rs.bk
*.pdb
*.swp

# ============================================================================
# Benchmark scratch output
#
# These directories are regenerated every time the corresponding script
# runs. They are large (gigabytes for whole-genome runs) and contain no
# information that is not already reproducible from the scripts + the
# committed result workbooks.
# ============================================================================

# Per-run FASTA outputs and TSV logs from run_benchmark.sh
tests/benchmark/benchmark_results/

# Per-configuration FASTA outputs from scaling_benchmark.sh
tests/benchmark/scaling_results/

# Per-dataset FASTA outputs from unphased_scaling_benchmark.sh
tests/benchmark/unphased_scaling_results/

# Scratch directory used by run_merged_output_check.sh
tests/benchmark/merged_check/

# Downloaded public datasets (GRCh38, Platinum, 1000G, genetic maps).
# Regenerated by tests/benchmark/scripts/download_data.sh.
tests/benchmark/datasets/

# Generated synthetic datasets (reference, VCFs, BAMs, reads).
# Regenerated by tests/benchmark/scripts/generate_synthetic_datasets.sh.
# This path already lives under datasets/, but listed explicitly in case
# someone moves the output root.
tests/benchmark/datasets/synthetic_unphased/

# ============================================================================
# Benchmark figures
#
# PNGs are committed — they are embedded by docs/BENCHMARK_RESULTS.md.
# PDFs are regenerable vector sources and are ignored.
# ============================================================================

docs/figures/*.pdf

# ============================================================================
# Benchmark results
#
# The three .xlsx workbooks under tests/benchmark/results/ ARE committed.
# They are the authoritative record of the published benchmark. Do not
# ignore that directory.
#
# Raw TSV logs that fed into them are not committed; they live under the
# scratch directories ignored above.
# ============================================================================

# (nothing to ignore here — this is a reminder, not a rule)

# ============================================================================
# Editor / IDE
# ============================================================================

# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (IntelliJ, CLion, RustRover)
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# Emacs
*#
.#*

# ============================================================================
# OS
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
.directory
.Trash-*

# ============================================================================
# Logs and temporary files at the repo root
#
# The tool writes vcf2fasta.log and vcf2fasta.warnings.log when no prefix
# is given. Catch stray runs from the repo root.
# ============================================================================

/vcf2fasta.log
/vcf2fasta.warnings.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# R
.Rhistory
.RData
.Rproj.user/

# Jupyter
.ipynb_checkpoints/

# ============================================================================
# Data files that should not be committed accidentally
#
# Guards against someone running the tool or a benchmark script with a
# prefix that lands in the repo. Adjust or remove if you legitimately want
# to commit small test data.
# ============================================================================

# Large genomic data
*.vcf.gz
*.vcf.gz.tbi
*.vcf.gz.csi
*.bcf
*.bam
*.bam.bai
*.cram
*.cram.crai
*.fa.gz
*.fasta.gz

# But NOT plain .fa / .fai — small reference fixtures may be committed
# under tests/. If you want to ignore those too, add:
# *.fa
# *.fai

# ============================================================================
# CUDA / build system leftovers
# ============================================================================

*.o
*.so
*.dylib
*.dll
*.a

# NVRTC / CUDA
*.ptx
*.cubin
*.fatbin